{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pouch-git",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "compatibility_flags": ["nodejs_als", "global_fetch_strictly_public"],

  "dev": {
    "port": 3200,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pouch-git",
      "database_id": "113b5e53-18a8-4e6e-b28e-edb3fd5a3317",
      "migrations_dir": "src/lib/db/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "pouch-media",
      "preview_bucket_name": "pouch-media",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "9c3967703f2a4eba869b005cff2ca0b3",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1234",
      "simple": { "limit": 100, "period": 10 },
    },
  ],
  "vars": {
    "MEDIA_PUBLIC_URL": "https://pouch-media.zomunk.dev",
  },
  "secrets": {
    "required": ["JWT_SECRET", "DOCS_SECRET", "MCP_ADMIN_SECRET"],
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
